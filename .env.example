APP_NAME="Easyti Database Provisioner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8082

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de dados do provisioner
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=database_provisioner
DB_USERNAME=postgres
DB_PASSWORD=

# Redis para filas
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Filas (usar Redis)
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Horizon
HORIZON_PREFIX=database-provisioner-horizon:

# Docker (opcional - se usar remote Docker)
DOCKER_HOST=unix:///var/run/docker.sock

# API Key para autenticação (gerar uma chave segura)
API_KEY=

# Domínio base para bancos de dados
DB_DOMAIN=easytidatabase.cloud

# IP do host Docker (usado para apontar DNS)
DOCKER_HOST_IP=147.78.120.1
